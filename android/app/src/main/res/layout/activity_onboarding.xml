<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zangi_bg_dark"
    android:padding="24dp">

    <!-- ÍCONE DO ZANGI COM GLOW -->
    <FrameLayout
        android:id="@+id/logoContainer"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_btn_send"
            android:elevation="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="7dp"
            android:gravity="center"
            android:text="Z"
            android:textColor="@color/zangi_white"
            android:textSize="44sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:letterSpacing="0.02"
        android:text="Zangi Mensageiro"
        android:textColor="@color/zangi_white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoContainer" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Comunicação privada e descentralizada.\nEscolha seu apelido e receba seu Número Privado de 10 dígitos na hora."
        android:textColor="@color/zangi_text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

    <!-- TAGS DE PRIVACIDADE EM PÍLULA -->
    <LinearLayout
        android:id="@+id/layoutTags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_private"
            android:text="🔒 Sem Chip"
            android:textColor="@color/zangi_green_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_private"
            android:text="🛡️ Sem SMS"
            android:textColor="@color/zangi_green_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_private"
            android:text="⚡ 10 Dígitos"
            android:textColor="@color/zangi_green_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- FORMULÁRIO DE ENTRADA -->
    <LinearLayout
        android:id="@+id/layoutForm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutTags">

        <EditText
            android:id="@+id/etNickname"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_chat_input"
            android:hint="Digite seu Nickname (ex: Carlos, Bia)..."
            android:inputType="textPersonName"
            android:paddingHorizontal="20dp"
            android:textColor="@color/zangi_white"
            android:textColorHint="@color/zangi_text_secondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnGenerateNumber"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_send"
            android:stateListAnimator="@null"
            android:text="Gerar Meu Número Zangi (10 Dígitos)"
            android:textColor="@color/zangi_white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- CARD DE REVELAÇÃO DO NÚMERO PRIVADO (COM ANIMAÇÃO) -->
    <FrameLayout
        android:id="@+id/cardRevealNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_card_reveal"
        android:elevation="8dp"
        android:padding="22dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutForm"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="SEU NÚMERO PRIVADO ZANGI:"
                android:textColor="@color/zangi_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGeneratedNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:letterSpacing="0.08"
                android:text="10-000-0000"
                android:textColor="@color/zangi_green_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Compartilhe este número com seus contatos para conversar sem expor seu telefone real!"
                android:textColor="@color/zangi_text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnEnterApp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_btn_send"
                android:stateListAnimator="@null"
                android:text="Entrar no Zangi e Começar"
                android:textColor="@color/zangi_white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
