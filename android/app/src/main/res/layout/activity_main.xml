<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/zangi_bg_dark">

    <!-- ======================================================== -->
    <!-- CONTAINER 1: HUB PRINCIPAL (LISTA DE CONVERSAS E GRUPOS) -->
    <!-- ======================================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hubContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:visibility="visible">

        <!-- CABEÇALHO DO USUÁRIO -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hubHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/zangi_header_dark"
            android:elevation="4dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/hubUserAvatarContainer"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:foreground="?attr/selectableItemBackground"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="23dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ivHubAvatarPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvHubAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_btn_send"
                        android:gravity="center"
                        android:textColor="@color/zangi_white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="S" />
                </androidx.cardview.widget.CardView>

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_btn_send" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/hubUserInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/hubActions"
                app:layout_constraintStart_toEndOf="@+id/hubUserAvatarContainer"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvHubUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/zangi_white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="Santos" />

                <TextView
                    android:id="@+id/tvHubUserNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/zangi_green_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="10-801-5725 (Copiar)" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hubActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <Button
                    android:id="@+id/btnHubAddContact"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_badge_private"
                    android:paddingHorizontal="10dp"
                    android:text="+ Contato"
                    android:textColor="@color/zangi_green_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnHubCreateGroup"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_private"
                    android:paddingHorizontal="10dp"
                    android:text="+ Grupo"
                    android:textColor="@color/zangi_green_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- LISTA DE CONVERSAS -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvConversations"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hubHeader"
            tools:listitem="@layout/item_conversation" />

        <TextView
            android:id="@+id/tvEmptyConversations"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Nenhuma conversa no momento.\nToque em + Contato ou + Grupo!"
            android:textColor="@color/zangi_text_secondary"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hubHeader" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ======================================================== -->
    <!-- CONTAINER 2: CHAT ATIVO (TEXTO, CÂMERA E CAPTURA DE TELA)-->
    <!-- ======================================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chatContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_chat_wallpaper"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- CABEÇALHO DO CHAT -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chatHeaderLayout"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:background="@color/zangi_header_dark"
            android:elevation="4dp"
            android:paddingHorizontal="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBackToHub"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voltar"
                android:src="@drawable/ic_arrow_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <FrameLayout
                android:id="@+id/avatarChatContainer"
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/btnBackToHub"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="21dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ivChatAvatarPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvChatAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_btn_send"
                        android:gravity="center"
                        android:textColor="@color/zangi_white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="A" />
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/chatContactInfoLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/badgeChatPrivate"
                app:layout_constraintStart_toEndOf="@+id/avatarChatContainer"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvChatTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/zangi_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Alexander M." />

                <TextView
                    android:id="@+id/tvChatSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/zangi_green_primary"
                    android:textSize="11sp"
                    tools:text="10-742-9901 • Online" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/badgeChatPrivate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_private"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Privado"
                    android:src="@drawable/ic_lock" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Privado"
                    android:textColor="@color/zangi_green_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- LISTA DE MENSAGENS -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toTopOf="@+id/bottomBarLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chatHeaderLayout"
            tools:listitem="@layout/item_message_sent" />

        <!-- BARRA INFERIOR DE ENVIO E CAPTURA -->
        <LinearLayout
            android:id="@+id/bottomBarLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/zangi_header_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp">

                <EditText
                    android:id="@+id/etMessageInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/input_hint"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:paddingVertical="8dp"
                    android:textColor="@color/zangi_white"
                    android:textColorHint="@color/zangi_text_secondary"
                    android:textSize="15sp" />

                <!-- Envio de Imagens da Galeria -->
                <ImageButton
                    android:id="@+id/btnPickGallery"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Galeria"
                    android:src="@drawable/ic_gallery"
                    app:tint="@color/zangi_green_primary" />

                <!-- Módulo 1: Câmera -->
                <ImageButton
                    android:id="@+id/btnCaptureCamera"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_camera"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/zangi_green_primary" />

                <!-- Módulo 2: Captura de Tela -->
                <ImageButton
                    android:id="@+id/btnCaptureScreen"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_screen"
                    android:src="@drawable/ic_screen_share"
                    app:tint="@color/zangi_icon_tint" />

            </LinearLayout>

            <!-- Botão Enviar -->
            <ImageButton
                android:id="@+id/btnSendMessage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_send"
                android:contentDescription="@string/action_send"
                android:elevation="4dp"
                android:padding="12dp"
                android:src="@drawable/ic_send" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
