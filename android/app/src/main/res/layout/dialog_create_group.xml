<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_modern"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_badge_private"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="👥"
            android:textSize="26sp" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Criar Grupo Privado"
        android:textColor="@color/zangi_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Crie um canal de comunicação em grupo criptografado de ponta a ponta."
        android:textColor="@color/zangi_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etGroupNameInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_chat_input"
        android:hint="Nome do Grupo (ex: Projeto Alpha)"
        android:inputType="textCapWords"
        android:paddingHorizontal="16dp"
        android:textColor="@color/zangi_white"
        android:textColorHint="@color/zangi_text_secondary"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelCreateGroup"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_private"
            android:text="Cancelar"
            android:textColor="@color/zangi_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnConfirmCreateGroup"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_send"
            android:stateListAnimator="@null"
            android:text="Criar Grupo"
            android:textColor="@color/zangi_white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnOpenJoinGroup"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_badge_private"
        android:text="🔗 Entrar em Grupo por Link / Código"
        android:textColor="@color/zangi_green_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
