<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_modern"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_badge_private">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🔗"
            android:textSize="26sp" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Entrar em um Grupo"
        android:textColor="@color/zangi_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Digite o Número do Grupo (ex: 10-GRP-8912) ou cole o Link de Convite recebido. O dono aprovará sua entrada."
        android:textColor="@color/zangi_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etJoinGroupInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_chat_input"
        android:hint="Ex: 10-GRP-8912 ou link..."
        android:inputType="textUri|text"
        android:paddingHorizontal="16dp"
        android:textColor="@color/zangi_white"
        android:textColorHint="@color/zangi_text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelJoinGroup"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_private"
            android:text="Cancelar"
            android:textColor="@color/zangi_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnConfirmJoinGroup"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_send"
            android:stateListAnimator="@null"
            android:text="Solicitar Entrada"
            android:textColor="@color/zangi_white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
